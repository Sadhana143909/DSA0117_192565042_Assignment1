#include <iostream>
using namespace std;

int calculateFare(int zone, int hour)
{
    int fare;

    if (hour < 0 || hour > 23)
        return -1;

    if (zone == 1)
        fare = 1000;
    else if (zone == 2)
        fare = 2000;
    else if (zone == 3)
        fare = 3000;
    else
        return -1;

    if ((hour >= 8 && hour < 10) ||
        (hour >= 17 && hour < 20))
    {
        fare = fare + fare * 20 / 100;
    }

    return fare;
}

int main()
{
    int zone, hour;

    cout << "Enter Zone: ";
    cin >> zone;

    cout << "Enter Hour: ";
    cin >> hour;

    int fare = calculateFare(zone, hour);

    if (fare == -1)
        cout << "Invalid Input";
    else
        cout << "Calculated Fare: Rs " << fare / 100;

    return 0;
}

