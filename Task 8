#include <iostream>
using namespace std;

int main()
{
    int zone;

    cout << "Enter Zone (1-3): ";
    cin >> zone;

    if (cin.fail())
    {
        cout << "Invalid Input";
    }
    else if (zone >= 1 && zone <= 3)
    {
        cout << "Valid Zone";
    }
    else
    {
        cout << "Invalid Zone";
    }

    return 0;
}

